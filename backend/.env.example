# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.

# MongoDB Atlas connection string
MONGO_URL=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/shopkart?retryWrites=true&w=majority

# JWT signing secret (use a long random string)
JWT_SECRET=your_jwt_secret_here

# Razorpay Test Mode credentials (from dashboard.razorpay.com)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret_here

# Frontend origin — set to your Vercel URL in production
CLIENT_URL=https://shop-kart-black-six.vercel.app

# Set to "production" on Render
NODE_ENV=production

# PORT is supplied automatically by Render — do not set it manually on Render
PORT=8080
